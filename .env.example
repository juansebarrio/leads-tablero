# Supabase
# Local (con `pnpm db:start`):
#   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   NEXT_PUBLIC_SUPABASE_ANON_KEY y SUPABASE_SERVICE_ROLE_KEY los imprime
#   `supabase start` al arrancar.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cron de reset diario (Vercel)
# Header esperado por /api/reset: Authorization: Bearer ${CRON_SECRET}
CRON_SECRET=
